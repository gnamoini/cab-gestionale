+/** Esecuzione inline su un documento (retry UI) — non dipende dalla coda globale né da next_retry_at. */
+export async function processDocumentAiIndexForDocumento(
+  sb: SupabaseClient,
+  documentoId: string,
+  indexId?: string,
+): Promise<DocumentAiIndexInlineResult> {
+  await reclaimStuckDocumentIndexJobs(sb);
+
+  let targetId = indexId;
+  if (!targetId) {
+    const { data } = await sb
+      .from("document_ai_index")
+      .select("id")
+      .eq("documento_id", documentoId)
+      .eq("is_active", true)
+      .maybeSingle();
+    targetId = (data?.id as string | undefined) ?? undefined;
+  }
+
+  if (!targetId) {
+    return {
+      indexProcessed: false,
+      understandingProcessed: false,
+      status: null,
+      understandingStatus: null,
+      errorMessage: null,
+    };
+  }
+
+  await sb
+    .from("document_ai_index")
+    .update({ next_retry_at: null, updated_at: new Date().toISOString() })
+    .eq("id", targetId)
+    .in("status", ["pending", "failed"]);
+
+  let indexProcessed = false;
+  let understandingProcessed = false;
+
+  const indexJob = await claimDocumentIndexJobById(sb, targetId);
+  if (indexJob) {
+    await processDocumentIndexJob(sb, indexJob);
+    indexProcessed = true;
+  }
+
+  const understandingJob = await claimUnderstandingJobById(sb, targetId);
+  if (understandingJob) {
+    await processUnderstandingJob(sb, understandingJob);
+    understandingProcessed = true;
+  }
+
+  const { data: final } = await sb
+    .from("document_ai_index")
+    .select("status, understanding_status, error_message")
+    .eq("id", targetId)
+    .maybeSingle();
+
+  return {
+    indexProcessed,
+    understandingProcessed,
+    status: (final?.status as string | null) ?? null,
+    understandingStatus: (final?.understanding_status as string | null) ?? null,
+    errorMessage: (final?.error_message as string | null) ?? null,
+  };
+}
