# Template Vercel Production — solo variabili client-safe
# Mai committare valori reali. Mai SUPABASE_SERVICE_ROLE_KEY su Vercel.

# Obbligatori
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Obbligatorio per reset password admin (redirect email)
NEXT_PUBLIC_SITE_URL=

# Observability (consigliato)
NEXT_PUBLIC_OBS_LOG_LEVEL=info
NEXT_PUBLIC_OBS_PERF=0

# Operatore può modificare impostazioni globali (RBAC + flag DB; opzionale per badge pilot UI)
NEXT_PUBLIC_ENABLE_OPERATOR_GLOBAL_SETTINGS=1

# Dati business solo su Supabase in production (non disattivare)
NEXT_PUBLIC_PREVENTIVI_DB_PRIMARY=true
# NON impostare NEXT_PUBLIC_SCHEDE_LOCAL_PRIMARY=true in production (forza fallback localStorage schede)

# Write Contract — VIETATO in production (usare .env.example solo per staging/dev):
# NON impostare NEXT_PUBLIC_INTERVENTO_WRITE_V2=1
# NON impostare NEXT_PUBLIC_INTERVENTO_WRITE_V2_SHADOW=1
# NON impostare NEXT_PUBLIC_INTERVENTO_WRITE_RPC=1
# Produzione: tutti unset (= v1 authoritative + ledger idempotency).
# NEXT_PUBLIC_SCHEDE_ENSURE_FORCE_ON_INVALIDATE=1

# NON impostare in production (bloccati da production:check):
# NEXT_PUBLIC_STAGING_PUBLIC=1
# NEXT_PUBLIC_CAB_OPS_WARN=1
# NEXT_PUBLIC_OBS_LOG_LEVEL=debug
# SUPABASE_SERVICE_ROLE_KEY=

# Opzionale — rate limit multi-istanza (server-only, mai NEXT_PUBLIC_*)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Web Push PWA (notifiche con app chiusa su mobile) — vedi docs/pwa-production-runbook.md
# Generare chiavi: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=          # server-only, mai NEXT_PUBLIC_
# VAPID_SUBJECT=mailto:service@example.com
# PWA_PUSH_ENABLED=true       # opzionale se le chiavi VAPID sono configurate
# CRON_SECRET=                # auth route /api/cron/push-delivery

# Server-only — Document Capture v4.1 (default on; set 0 to force legacy during soak)
# DOCUMENT_CAPTURE_V41=1
# NEXT_PUBLIC_DOCUMENT_CAPTURE_V41=1
# Estrazione ibrida: PDF text + Tesseract bbox + Gemini fallback (default on; =0 → Gemini-only)
# DOCUMENT_CAPTURE_HYBRID_EXTRACTION=1

# Server-only — AI Runtime Manager v2 (AI Control Plane)
# SSOT operativo: Supabase ai_provider_keys. Vedi /impostazioni/ai-providers
AI_MASTER_KEY_ENCRYPTION_KEY=   # obbligatorio per cifrare chiavi in DB
CRON_SECRET=                    # /api/cron/ai-runtime-sync (ogni 5–10 min)
AI_RUNTIME_BOOTSTRAP_FALLBACK_ENABLED=true  # false dopo stabilizzazione

# Bootstrap scalabile (sync cron → ai_provider_keys)
# AI_PROVIDER_GOOGLE_KEY_01=
# AI_PROVIDER_GOOGLE_KEY_02=
# AI_PROVIDER_GOOGLE_KEY_03=

# Legacy compat (deprecate — import via sync)
# GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY_SECONDARY=

# Opzionale
# AI_DEFAULT_PROVIDER=google
# AI_MODEL_GOOGLE=gemini-3.5-flash
# AI_TIMEOUT_MS=90000

# Mobile focus visibility — Focus Transaction pipeline V2 (default on; rollback = false)
# NEXT_PUBLIC_MOBILE_FOCUS_VISIBILITY_V2=false
# NEXT_PUBLIC_CAB_FOCUS_DEBUG=true        # overlay debug su device (solo collaudo)

# Inventory label PDF (server-only)
# INVENTORY_LABEL_PDF_PIPELINE_V2=1       # 0 = rollback legacy font path
# LABEL_PDF_RENDER_CONCURRENCY=4          # 2–8, default 4
# LABEL_BULK_SYNC_MAX=20                  # sync HTTP cap
# LABEL_PDF_GENERATION_TIMEOUT_MS=240000
