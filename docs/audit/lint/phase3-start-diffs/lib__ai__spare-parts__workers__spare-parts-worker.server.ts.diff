+async function touchDocumentIndexHeartbeat(sb: SupabaseClient, indexId: string): Promise<void> {
+  await sb
+    .from("document_ai_index")
+    .update({ updated_at: new Date().toISOString() })
+    .eq("id", indexId);
+}
+
+async function withIndexHeartbeat(sb: SupabaseClient, indexId: string, run: () => Promise<void>): Promise<void> {
+  const timer = setInterval(() => {
+    void touchDocumentIndexHeartbeat(sb, indexId);
+  }, INDEX_HEARTBEAT_MS);
+  try {
+    await touchDocumentIndexHeartbeat(sb, indexId);
+    await run();
+    await touchDocumentIndexHeartbeat(sb, indexId);
+  } finally {
+    clearInterval(timer);
+  }
+}
 
