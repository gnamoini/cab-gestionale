    "release:gate": "npx tsx scripts/release-gate.ts",
    "production:check": "npx tsx scripts/production-check.ts",
    "test:production-readiness": "npx tsx lib/production/production-readiness.test.ts",
    "ux:enforce": "npx tsx scripts/ux-enforcement-check.ts",
    "ux:mobile-gate": "npx tsx scripts/ux-mobile-regression-gate.ts",
