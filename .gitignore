# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/public/sw.js

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cursor/debug*.log
dev-probe.log
debug-929eab.log
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.smoke.example
!.env.production.example
.ai-prod-keys.tmp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# MAP runtime snapshots (keep directory via .gitkeep)
/map/burndown/*.json
/map/telemetry/*.json
/map/telemetry-export.json
/map/promotion-sidecar.json
/map/waves/**/map-wave-*.json
/map/stability/classifier-snapshots/*.json
/map/stability/tier-lock-registry.json

# Supabase MCP apply artifacts (not official migrations)
supabase/migrations/_*

# Control Plane generated inventory (regenerate: npm run control:inventory)
control-inventory.json
control-report.json
strict-label-validation.json
shadow-cutover-report.json
control-duration-baseline.json
control-certification/
control-health/
