+function formatPartPrice(price: PriceEvidence | null | undefined): string | null {
+  if (!price || !Number.isFinite(price.amount)) return null;
+  try {
+    return new Intl.NumberFormat("it-IT", {
+      style: "currency",
+      currency: price.currency || "EUR",
