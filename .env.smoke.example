# Template smoke Playwright / release-gate locale
# Copiare in .env.local o esportare in shell — non committare credenziali reali.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opzionale: override base URL (default http://127.0.0.1:3210 in CI)
SMOKE_BASE_URL=
SMOKE_PORT=3210

# Obbligatorio per smoke:playwright e release:gate completo
# Usare SOLO account dedicato smoke — mai admin/operatore reali su production DB.
# Creazione: npx tsx scripts/ensure-local-smoke-secrets.ts [--mark-production]
SMOKE_ADMIN_EMAIL=
SMOKE_ADMIN_PASSWORD=

# Production DB guard — URL Supabase production (per bloccare E2E mutanti senza opt-in)
# Impostato automaticamente da ensure-local-smoke-secrets.ts --mark-production
SMOKE_PRODUCTION_SUPABASE_URL=

# Opt-in esplicito per spec che creano dati (AUDIT-*) su production DB
# Richiede anche SUPABASE_SERVICE_ROLE_KEY in .env.local per teardown
# SMOKE_ALLOW_PRODUCTION_MUTATIONS=1

# Opzionale: spec RBAC operatore (skip se assenti)
SMOKE_OPERATOR_EMAIL=
SMOKE_OPERATOR_PASSWORD=

# Opzionale: isolamento portale clienti — ID lavorazione di altro cliente (skip se assenti)
SMOKE_CLIENT_EMAIL=
SMOKE_CLIENT_PASSWORD=
SMOKE_CLIENT_LAVORAZIONE_ALIEN_ID=

# Opzionale: upload documenti smoke (skip se assente)
SMOKE_DOCUMENTI_LAVORAZIONE_ID=

# Locale: salta Playwright in release:gate / smoke:gate
# SMOKE_SKIP=1

# UI OS Phase 2 — opt-in shadow/active compare (DEV only, non impostare in prod)
# NEXT_PUBLIC_CAB_UI_OS=1
