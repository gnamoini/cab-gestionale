{
  "name": "gestionale-cab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx tsx scripts/ensure-dev-unlocked.ts && next dev",
    "dev:lag-probe": "npx tsx scripts/dev-cursor-lag-probe.ts",
    "dev:cpu-probe": "npx tsx scripts/dev-cpu-crash-probe.ts",
    "dev:cpu-probe:webpack": "npx tsx scripts/dev-cpu-crash-probe.ts --webpack",
    "dev:fresh": "npx tsx scripts/ensure-dev-unlocked.ts && npx tsx scripts/clean-next-dev-cache.ts && next dev",
    "dev:webpack": "next dev --webpack",
    "clean:next": "npx tsx scripts/clean-next-dev-cache.ts",
    "clean:next:all": "npx tsx scripts/clean-next-dev-cache.ts --all",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:permissions": "npx tsx src/lib/permissions/effective-permissions.test.ts",
    "test:operator-global-settings": "npx tsx lib/permissions/operator-global-settings.test.ts",
    "ci:tsc": "npx tsx scripts/ci-tsc-gate.ts",
    "ci:build": "npx tsx scripts/ci-build-gate.ts",
    "release:gate": "npx tsx scripts/release-gate.ts",
    "production:check": "npx tsx scripts/production-check.ts",
    "test:production-readiness": "npx tsx lib/production/production-readiness.test.ts",
    "ux:enforce": "npx tsx scripts/ux-enforcement-check.ts",
    "ux:mobile-gate": "npx tsx scripts/ux-mobile-regression-gate.ts",
    "ios:check": "npx tsx scripts/mobile-ios-regression-check.ts",
    "smoke:regression": "npx tsx scripts/smoke-regression-tests.ts",
    "smoke:regression:core": "npx tsx scripts/smoke-regression-tests.ts --core",
    "smoke:regression:extended": "npx tsx scripts/smoke-regression-tests.ts --extended",
    "smoke:structural": "npx tsx scripts/smoke-structural-gate.ts",
    "smoke:playwright": "npx playwright test -c e2e/playwright.config.ts",
    "smoke:playwright:ios-smoke": "npx playwright test -c e2e/playwright.mobile-cert.config.ts --project=mobile-ios-chromium --grep \"iOS regression\"",
    "smoke:playwright:cert": "npx playwright test -c e2e/playwright.mobile-cert.config.ts --grep \"iOS regression\"",
    "smoke:playwright:ricambio:smoke": "npx playwright test -c e2e/playwright.ricambio-cert.config.ts --project=chromium",
    "smoke:playwright:ricambio:cert": "npx playwright test -c e2e/playwright.ricambio-cert.config.ts --project=chromium",
    "ci:supabase:publication": "npx tsx scripts/verify-supabase-publication.ts --mode=sanity",
    "ci:supabase:publication:full": "npx tsx scripts/verify-supabase-publication.ts --mode=full",
    "smoke:gate": "npx tsx scripts/smoke-gate.ts",
    "flex:baseline:generate": "npx tsx scripts/generate-flex-baseline.ts --update",
    "flex:baseline:diff": "npx tsx scripts/diff-flex-baseline.ts",
    "flex:eslint:gate": "npx tsx scripts/flex-eslint-gate.ts",
    "flex:freeze:gate": "npx tsx scripts/flex-freeze-gate.ts",
    "ui:flex-route:audit": "npx tsx scripts/ui-flex-route-audit.ts",
    "ui:final-stability:audit": "npx tsx scripts/ui-final-stability-audit.ts",
    "ui:final-stability:manifest:generate": "npx tsx scripts/generate-ui-final-stability-manifest.ts --update",
    "global-table-head:audit": "npx tsx scripts/global-table-head-audit.ts",
    "ops:diagnostics": "npx tsx scripts/ops-diagnostics.ts",
    "ops:long-session-soak": "npx tsx scripts/long-session-soak-audit.ts",
    "ops:long-session-soak:threshold": "npx tsx scripts/long-session-soak-audit.ts --samples 12 --interval-ms 30000 --gate",
    "documenti:storage-inventory": "npx tsx scripts/documenti-storage-inventory.ts",
    "documenti:remediate-url-file": "npx tsx scripts/remediate-documenti-url-file.ts",
    "ops:env-check": "npx tsx scripts/ops-env-check.ts",
    "audit:rls": "npx tsx scripts/rls-service-audit.ts",
    "audit:supabase": "npx tsx scripts/supabase-audit-inventory.ts",
    "audit:supabase:json": "npx tsx scripts/supabase-audit-inventory.ts --json",
    "analyze": "npx tsx scripts/analyze-bundle.ts"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.8",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-virtual": "^3.14.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "next": "16.2.6",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.7",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "pg": "^8.21.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
