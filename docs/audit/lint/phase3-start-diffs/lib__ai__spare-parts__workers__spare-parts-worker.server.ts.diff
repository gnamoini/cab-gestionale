+/** Esecuzione diretta (API /start) — non dipende da pg_cron né da waitUntil. */
+export async function runPartSearchForId(
+  sb: SupabaseClient,
+  searchId: string,
+  input: SparePartSearchInput,
+): Promise<void> {
+  const { data: row } = await sb
+    .from("ai_part_searches")
+    .select("id, status, attempt_count")
+    .eq("id", searchId)
+    .maybeSingle();
+
+  if (!row) return;
+  if (row.status === "completed" || row.status === "failed" || row.status === "cancelled") return;
+
+  if (row.status === "pending" || row.status === "draft") {
+    const { error } = await sb
+      .from("ai_part_searches")
+      .update({
+        status: "processing",
+        attempt_count: Number(row.attempt_count ?? 0) + 1,
+        updated_at: new Date().toISOString(),
+      })
+      .eq("id", searchId)
+      .in("status", ["pending", "draft"]);
+    if (error) throw new Error(error.message);
+  }
+
+  await processPartSearchJob(sb, { id: searchId, input_json: input as Record<string, unknown> });
+}
