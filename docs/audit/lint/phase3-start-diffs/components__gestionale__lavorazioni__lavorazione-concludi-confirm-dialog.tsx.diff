+
+function initialCompletionDateText(row: LavorazioneListRow): string {
+  const uscita = row.data_uscita?.trim();
+  if (uscita) {
+    if (/^\d{4}-\d{2}-\d{2}$/.test(uscita)) return ymdToItDisplay(uscita);
+    return isoToItDisplay(uscita);
+  }
+  return isoToItDisplay(localCalendarDayIsoFromDate());
+}
 
 export function LavorazioneConcludiConfirmDialog({
+  row,
   open,
   onCancel,
   onConfirm,
   pending,
 }: {
+  row: LavorazioneListRow | null;
   open: boolean;
   onCancel: () => void;
-  onConfirm: () => void;
+  onConfirm: (completionYmd: string) => void;
   pending?: boolean;
 }) {
+  const [dateText, setDateText] = useState("");
+  const [dateErr, setDateErr] = useState<string | null>(null);
+  const submitLock = useSubmitLock();
+
+  useEffect(() => {
+    if (!open || !row) return;
+    setDateText(initialCompletionDateText(row));
+    setDateErr(null);
+  }, [open, row]);
+
+  if (!open || !row) return null;
+
+  const macchina = lavorazioneOggettoLabel(row);
+  const targa = row.mezzo?.targa?.trim();
+  const ingressoIt = row.data_ingresso?.trim()
+    ? /^\d{4}-\d{2}-\d{2}$/.test(row.data_ingresso.trim())
+      ? ymdToItDisplay(row.data_ingresso.trim())
+      : isoToItDisplay(row.data_ingresso)
+    : null;
+
+  async function onSubmit(e: FormEvent<HTMLFormElement>) {
+    e.preventDefault();
+    if (pending) return;
+
+    await runSubmitFromGetter(
+      e.currentTarget,
+      submitLock,
+      () => ({ dateText }),
+      (snap) => {
+        const parsed = parseItalianDayDisplayToIso(snap.dateText);
+        if (!parsed.ok) {
+          setDateErr("Data non valida. Usa gg/mm/aaaa.");
+          return;
+        }
+        const completionYmd = isoToDateInputValue(parsed.iso);
+        const ingressoYmd = row.data_ingresso?.trim().slice(0, 10);
+        if (ingressoYmd && completionYmd < ingressoYmd) {
+          setDateErr("La data di completamento non può essere precedente alla data di ingresso.");
+          return;
+        }
+        setDateErr(null);
+        onConfirm(completionYmd);
+      },
+    );
+  }
